# Admin Tool Configuration

# Optional: Password protect the admin tool
# Leave empty for no password protection (only run locally!)
ADMIN_PASSWORD=

# Optional: Custom port (default: 3000)
ADMIN_PORT=3000

# Required: Your Telegram credentials (for creating invite codes)
# These will be auto-filled in the invite code form
# To find your User ID: Open @userinfobot on Telegram
ADMIN_TELEGRAM_USER_ID=123456789
ADMIN_TELEGRAM_USERNAME=@yourusername

# Required for broadcast push notifications: Telegram bot token
# Same token used by the worker service in production
# Found at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Optional: default Google Sheet for invoice amount edits (same as worker SHEET_ID)
# Used when a customer has no per-chat sheetId configured
SHEET_ID=
