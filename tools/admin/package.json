{
  "name": "@invofox/admin",
  "version": "1.0.0",
  "description": "Local admin tool for managing GCP Firestore and Cloud Storage for Invofox",
  "main": "server.ts",
  "author": "Ido Betesh",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register server.ts",
    "dev": "nodemon",
    "lint": "eslint src/ server.ts",
    "lint:fix": "eslint src/ server.ts --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.3.0",
    "@google-cloud/storage": "^7.7.0",
    "archiver": "^7.0.1",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "http-status-codes": "^2.3.0",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0"
  }
